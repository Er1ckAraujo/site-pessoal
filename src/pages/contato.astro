---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Contato" description={`Como falar com ${site.name}.`}>
  <section class="page-head">
    <span class="label">Contato</span>
    <h1>Vamos conversar</h1>
    <p class="intro">
      O jeito mais rápido de falar comigo é por e-mail. Eu posso te ajudar a organizar o fluxo de informação da sua
      empresa e levar os dados até a estratégia.
    </p>
  </section>

  <section class="block">
    <div>
      <span class="label">E-mail</span>
    </div>
    <div>
      <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="actions">
        <button class="cta copy" type="button" data-email={site.email}>Copiar e-mail</button>
        <span class="copied muted" role="status" aria-live="polite"></span>
      </div>
    </div>
  </section>

  <section class="block">
    <div>
      <span class="label">Também estou em</span>
    </div>
    <ul class="channels">
      <li><a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      <li><a href={site.github} rel="me noopener" target="_blank">GitHub</a></li>
    </ul>
  </section>
</Base>

<script>
  // O link mailto não faz nada em quem não tem app de e-mail configurado; copiar sempre funciona.
  const button = document.querySelector<HTMLButtonElement>('.copy');
  const status = document.querySelector('.copied');
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.email ?? '');
      if (status) status.textContent = 'Copiado.';
    } catch {
      if (status) status.textContent = 'Não consegui copiar; selecione o endereço acima.';
    }
  });
</script>

<style>
  .email {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.4rem, 4.5vw, 2.6rem);
    letter-spacing: -0.02em;
    margin: 0 0 1.75rem;
    overflow-wrap: anywhere;
  }

  .email a {
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .email a:hover {
    border-color: var(--green);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .copied {
    font-size: 0.9rem;
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }

  .channels li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .channels a {
    font-family: var(--serif);
    font-size: 1.4rem;
    text-decoration: none;
  }

  .channels a:hover {
    color: var(--green);
  }
</style>
